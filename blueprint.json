{
  "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
  "install": {
    "title": "REA ATE Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    }
  ],
  "modules": [
    {
      "name": "Common",
      "state": "activate"
    },
    {
      "name": "AdvancedSearch",
      "state": "activate"
    }
  ],
  "themes": [
    {
      "name": "rea-ate",
      "source": "https://github.com/ateeducacion/omeka-s-theme-rea-ate/archive/refs/heads/master.zip"
    }
  ],
  "sites": [
    {
      "title": "REA ATE Demo",
      "slug": "demo",
      "theme": "rea-ate",
      "summary": "Minimal install to preview the REA ATE theme (with AdvancedSearch) in Omeka S Playground.",
      "isPublic": true,
      "setAsDefault": true
    }
  ],
  "x-playground": {
    "debug": {
      "enabled": true
    },
    "landingPage": "/admin"
  }
}
