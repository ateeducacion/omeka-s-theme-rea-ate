<?php
/** @var \Omeka\Api\Representation\ItemRepresentation|null $projectItem */
if (!isset($projectItem) || $projectItem === null) { return; }

$escape    = $this->plugin('escapeHtml');
$escAttr   = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');
$safeUrl   = $this->plugin('SafeUrl');

// Los proyectos catalogados con la plantilla básica usan dcterms:title.
$name        = $projectItem->value('schema:name') ?: $projectItem->value('dcterms:title');
$url         = $projectItem->value('schema:url');

$logoUrl = null;
$logoValue = $projectItem->value('schema:logo');
if ($logoValue) {
    // Un media o un ítem enlazado, sea cual sea el tipo; de un ítem se toma su media principal.
    $logoMedia = $logoValue->valueResource();
    if ($logoMedia) {
        if ($logoMedia instanceof \Omeka\Api\Representation\ItemRepresentation) {
            $logoMedia = $logoMedia->primaryMedia();
        }
        if ($logoMedia instanceof \Omeka\Api\Representation\MediaRepresentation) {
            $logoUrl = $logoMedia->thumbnailUrl('large') ?: $logoMedia->originalUrl();
        }
    } elseif ($logoValue->uri()) {
        $logoUrl = $logoValue->uri();
    } else {
        $raw = trim((string) $logoValue);
        if ($raw !== '') { $logoUrl = $raw; }
    }
}
if (!$logoUrl) {
    $primary = $projectItem->primaryMedia();
    if ($primary) {
        $logoUrl = $primary->thumbnailUrl('large') ?: $primary->originalUrl();
    }
}

// Both values come from item metadata (schema:logo, schema:url), which is catalogue
// content: without a scheme allowlist a "javascript:" URI would execute on click.
$logoUrl = $safeUrl($logoUrl);

if (!$name && !$logoUrl) { return; }

$urlStr = '';
if ($url) {
    $urlStr = $safeUrl($url->uri() ?: trim((string) $url)) ?? '';
}

// Sidebar row (_sidebar-row.scss): logo as media, name as title. The row goes to
// the project's own site when there is one, otherwise to its item page. The
// long description stays on that page.
$rowUrl = $urlStr !== '' ? $urlStr : $projectItem->url();
$isExternal = $urlStr !== '';
?>
<aside class="project-funding" aria-label="<?php echo $escAttr($translate('Proyecto cofinanciador')); ?>">

    <span class="project-funding__eyebrow">
        <?php echo $escape($translate('Proyecto cofinanciador')); ?>
    </span>

    <a class="sidebar-row sidebar-row--link" href="<?php echo $escAttr($rowUrl); ?>"<?php
        echo $isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
    ?>>
        <?php if ($logoUrl): ?>
        <span class="sidebar-row__media sidebar-row__media--logo">
            <img src="<?php echo $escAttr($logoUrl); ?>"
                 alt="<?php echo $name ? '' : $escAttr($translate('Logo del proyecto')); ?>">
        </span>
        <?php endif; ?>
        <span class="sidebar-row__text">
            <?php if ($name): ?>
            <span class="sidebar-row__title"><?php echo $escape((string) $name); ?></span>
            <?php endif; ?>
            <span class="sidebar-row__meta"><?php echo $escape($translate($isExternal ? 'Web del proyecto' : 'Ficha del proyecto')); ?></span>
        </span>
        <span class="sidebar-row__chevron material-symbols-outlined" aria-hidden="true"><?php echo $isExternal ? 'open_in_new' : 'chevron_right'; ?></span>
    </a>

</aside>
