<?php
$translate = $this->plugin('translate');
$escape    = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$this->htmlElement('body')->appendAttribute('class', 'item-set resource browse');

$api    = $this->api();
$siteId = $this->currentSite()->id();

// Pre-compute visible sets (with item count, skipping empty)
$visibleSets = [];
foreach ($itemSets as $itemSet) {
    $count = $api->search('items', [
        'item_set_id' => $itemSet->id(),
        'site_id'     => $siteId,
        'is_public'   => true,
        'limit'       => 1,
    ])->getTotalResults();
    if ($count > 0) {
        $visibleSets[] = ['itemSet' => $itemSet, 'count' => $count];
    }
}

// Pagination stays the controller's (total item sets in the site, site per-page
// setting). The count queries above do not touch the paginator; overriding it with
// the visible sets of this page made later pages unreachable.
$pagination = $this->pagination();

// Filter values of each visible set, as [slug => label] per filter.
//
// Values may be literals, URIs or linked curriculum terms (cur: model of
// curriculo_lomloe_canarias):
// - Nivel: lrmi:educationalLevel (preferred) or lom:educationalLevel.
// - Etapa: the cur:etapa of each linked course, plus lrmi:educationalAlignment
//   values that are not a stage subject (the former literal «Etapa»).
// - Temática: schema:about (a cur:MateriaCurso counts as its stage subject,
//   cur:materia) or dcterms:subject, plus stage subjects (cur:Materia) linked
//   in lrmi:educationalAlignment, which is what OERManager writes on REA.
// Theme helpers are autoloaded only once fetched from the plugin manager, so
// fetch both before calling their static methods.
$helpers      = $this->getHelperPluginManager();
$slugifyClass = get_class($helpers->get('SlugifyValues'));
$anchorHelper = $helpers->get('CurriculumAnchor');
$anchorClass  = get_class($anchorHelper);
$stageOrder   = $anchorHelper->stageOrder();
$classTerm = function ($resource): string {
    $class = $resource ? $resource->resourceClass() : null;
    return $class ? $class->term() : '';
};
$add = function (array &$list, string $label) use ($slugifyClass): void {
    $slug = $slugifyClass::slug($label);
    if ($slug !== '' && !isset($list[$slug])) {
        $list[$slug] = $label;
    }
};
$stageRanks = [];
$filterValues = function ($is) use ($slugifyClass, $anchorClass, $stageOrder, $classTerm, $add, &$stageRanks): array {
    $etapa = $nivel = $tematica = [];

    $levelValues = $is->value('lrmi:educationalLevel', ['all' => true]) ?: $is->value('lom:educationalLevel', ['all' => true]) ?: [];
    foreach ($levelValues as $v) {
        $add($nivel, $slugifyClass::label($v));
        $course = $v->valueResource();
        $stage  = $course ? $course->value($anchorClass::CUR_STAGE) : null;
        $stage  = $stage ? $stage->valueResource() : null;
        if ($stage) {
            $label = trim((string) $stage->displayTitle());
            $add($etapa, $label);
            $notation = $stage->value('skos:notation');
            $stageRanks[$slugifyClass::slug($label)] = $anchorClass::stageRank(
                $notation ? (string) $notation : null,
                null,
                $stageOrder
            );
        }
    }

    foreach ($is->value('lrmi:educationalAlignment', ['all' => true]) ?: [] as $v) {
        $linked = $v->valueResource();
        if ($linked && $classTerm($linked) === 'cur:Materia') {
            $add($tematica, $slugifyClass::label($v));
        } else {
            $add($etapa, $slugifyClass::label($v));
        }
    }

    $topicValues = $is->value('schema:about', ['all' => true]) ?: $is->value('dcterms:subject', ['all' => true]) ?: [];
    foreach ($topicValues as $v) {
        $linked  = $v->valueResource();
        $subject = $linked ? $linked->value($anchorClass::CUR_SUBJECT) : null;
        $subject = $subject ? $subject->valueResource() : null;
        $add($tematica, $subject ? trim((string) $subject->displayTitle()) : $slugifyClass::label($v));
    }

    return ['etapa' => $etapa, 'nivel' => $nivel, 'tematica' => $tematica];
};

// Build filter select options from visible sets.
$etapas = $niveles = $tematicas = [];
foreach ($visibleSets as $i => $entry) {
    $values = $filterValues($entry['itemSet']);
    $visibleSets[$i]['filters'] = $values;
    $etapas    += $values['etapa'];
    $niveles   += $values['nivel'];
    $tematicas += $values['tematica'];
}
// Stages in curriculum order (curriculum_stage_order); other labels after, alphabetically.
uksort($etapas, function ($a, $b) use ($stageRanks, $etapas) {
    return (($stageRanks[$a] ?? PHP_INT_MAX) <=> ($stageRanks[$b] ?? PHP_INT_MAX))
        ?: strcoll($etapas[$a], $etapas[$b]);
});
?>

<!-- PAGE HEADER -->
<header class="item-set-browse-header">
    <div class="item-set-browse-header__text">
        <h1 class="item-set-browse-header__title"><?= $escape($translate('Colecciones')) ?></h1>
        <p class="item-set-browse-header__subtitle"><?= $escape($translate('Recursos agrupados por colección temática.')) ?></p>
    </div>

    <!-- FILTER BAR (Integrated) -->
    <div class="collection-filter-bar" role="region" aria-label="<?= $escapeAttr($translate('Filtrar colecciones')) ?>">
        <span class="collection-filter-bar__label">
            <span class="material-symbols-outlined" aria-hidden="true">tune</span>
            <?= $escape($translate('Filtrar')) ?>
        </span>

        <?php if ($etapas): ?>
        <div class="collection-filter-select">
            <select id="filter-etapa" aria-label="<?= $escapeAttr($translate('Filtrar por etapa')) ?>">
                <option value=""><?= $escape($translate('Etapa')) ?></option>
                <?php foreach ($etapas as $slug => $label): ?>
                    <option value="<?= $escapeAttr($slug) ?>"><?= $escape($label) ?></option>
                <?php endforeach; ?>
            </select>
        </div>
        <?php endif; ?>

        <?php if ($niveles): ?>
        <div class="collection-filter-select">
            <select id="filter-nivel" aria-label="<?= $escapeAttr($translate('Filtrar por nivel')) ?>">
                <option value=""><?= $escape($translate('Nivel')) ?></option>
                <?php foreach ($niveles as $slug => $label): ?>
                    <option value="<?= $escapeAttr($slug) ?>"><?= $escape($label) ?></option>
                <?php endforeach; ?>
            </select>
        </div>
        <?php endif; ?>

        <?php if ($tematicas): ?>
        <div class="collection-filter-select">
            <select id="filter-tematica" aria-label="<?= $escapeAttr($translate('Filtrar por temática')) ?>">
                <option value=""><?= $escape($translate('Temática')) ?></option>
                <?php foreach ($tematicas as $slug => $label): ?>
                    <option value="<?= $escapeAttr($slug) ?>"><?= $escape($label) ?></option>
                <?php endforeach; ?>
            </select>
        </div>
        <?php endif; ?>

        <button type="button" class="collection-filter-clear" id="collection-filter-clear">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
            <?= $escape($translate('Limpiar')) ?>
        </button>
    </div>
</header>

<?php $this->trigger('view.browse.before'); ?>

<div class="item-set-browse-results-info">
    <div class="item-set-browse-header__count">
        <strong><?= count($visibleSets) ?></strong> <?= $escape($translate('colecciones')) ?>
    </div>
</div>

<!-- COLLECTIONS GRID -->
<div class="collections-grid" id="collections-grid">

    <?php foreach ($visibleSets as $entry):
        $itemSet  = $entry['itemSet'];
        $itemCount = $entry['count'];

        $coverUrl = $itemSet->thumbnailDisplayUrl('large');

        $etapaSlugs   = implode(' ', array_keys($entry['filters']['etapa']));
        $nivelSlugs   = implode(' ', array_keys($entry['filters']['nivel']));
        $temaSlugs    = implode(' ', array_keys($entry['filters']['tematica']));

        $description  = $itemSet->displayDescription();
    ?>
    <a href="<?= $escapeAttr($itemSet->siteUrl()) ?>" class="collection-card"
       data-etapa="<?= $escapeAttr($etapaSlugs) ?>"
       data-nivel="<?= $escapeAttr($nivelSlugs) ?>"
       data-tematica="<?= $escapeAttr($temaSlugs) ?>">

        <?php if ($coverUrl): ?>
            <div class="collection-card__cover">
                <img src="<?= $escapeAttr($coverUrl) ?>"
                     alt="<?= $escapeAttr($itemSet->displayTitle()) ?>">
            </div>
        <?php else: ?>
            <div class="collection-card__cover collection-card__cover--fallback">
                <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
            </div>
        <?php endif; ?>

        <div class="collection-card__title-strip">
            <h2 class="collection-card__title"><?= $escape($itemSet->displayTitle()) ?></h2>
            <span class="collection-card__count-pill">
                <?= (int) $itemCount ?> <?= $escape($translate('recursos')) ?>
            </span>
        </div>

        <div class="collection-card__body">
            <?php if ($description): ?>
                <p class="collection-card__description"><?= $escape($description) ?></p>
            <?php endif; ?>
            <span class="collection-card__cta">
                <?= $escape($translate('Ver colección')) ?>
                <span class="collection-card__cta-arrow">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </span>
            </span>
        </div>
    </a>
    <?php endforeach; ?>

    <div class="collections-grid__empty-state" id="collections-empty-state" hidden>
        <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
        <?= $escape($translate('No hay colecciones que coincidan con los filtros seleccionados.')) ?>
    </div>

</div>

<?php $this->trigger('view.browse.after'); ?>

<?= $pagination ?>

