<?php
$translate  = $this->plugin('translate');
$escape     = $this->plugin('escapeHtml');
$this->inlineScript()->appendFile($this->assetUrl('js/advanced-search.js'));
$this->htmlElement('body')->appendAttribute('class', 'items search advanced-search-edu');

$query = $this->params()->fromQuery();

// Property ID lookups — installation-independent.
$eduPropTerms = [
    'lrmi:educationalLevel'     => 'Nivel educativo',
    'lrmi:learningResourceType' => 'Tipo de recurso',
    'schema:about'              => 'Materia o tema',
    'lrmi:educationalAlignment' => 'Materia',
    'lrmi:educationalRole'      => 'Audiencia destinataria',
    'lrmi:timeRequired'         => 'Duración',
];
$eduProps = [];
foreach (array_keys($eduPropTerms) as $term) {
    try {
        $prop = $this->api()->searchOne('properties', ['term' => $term])->getContent();
        if ($prop) $eduProps[$term] = $prop->id();
    } catch (\Exception $e) {}
}

// Build prop-id → array of text values from the incoming query (supports multi-value).
// The form sends one condition per group (see asset/js/advanced-search.js): property
// rows with text[] for res/list, AdvancedSearch filter rows with val[] for the rest.
// Single-value property rows from older links are read too. A field may be an id or
// a term.
$existingPropValues = [];
$propIdOf = function ($field) use ($eduProps): int {
    if (is_numeric($field)) {
        return (int) $field;
    }
    return is_string($field) ? (int) ($eduProps[$field] ?? 0) : 0;
};
$addExisting = function (int $pid, $values) use (&$existingPropValues): void {
    if (!$pid) {
        return;
    }
    foreach ((array) $values as $v) {
        if (is_scalar($v) && (string) $v !== '') {
            $existingPropValues[$pid][] = (string) $v;
        }
    }
};
foreach ($query['property'] ?? [] as $ep) {
    if (is_array($ep)) {
        $addExisting($propIdOf($ep['property'] ?? 0), $ep['text'] ?? []);
    }
}
foreach ($query['filter'] ?? [] as $ef) {
    if (is_array($ef)) {
        $addExisting($propIdOf($ef['field'] ?? 0), $ef['val'] ?? []);
    }
}

// Returns all existing text values for a property term (array).
$propVals = function (string $term) use ($eduProps, $existingPropValues): array {
    return isset($eduProps[$term]) ? ($existingPropValues[$eduProps[$term]] ?? []) : [];
};

// Pre-select lrmi:LearningResource class unless already set by the user.
$lrmiClassId = null;
if (empty($query['resource_class_id'])) {
    try {
        $cls = $this->api()->searchOne('resource_classes', ['term' => 'lrmi:LearningResource'])->getContent();
        if ($cls) {
            $lrmiClassId = $cls->id();
            $query['resource_class_id'] = [$lrmiClassId];
        }
    } catch (\Exception $e) {}
} else {
    $lrmiClassId = (int) ($query['resource_class_id'][0] ?? 0) ?: null;
}

// Both the count and the collections filter are scoped to the current site: the
// browse page they lead to only lists this site's items.
$siteId = $this->currentSite()->id();

// Total resources for count badge.
$totalResources = null;
if ($lrmiClassId) {
    try {
        $totalResources = $this->api()->search('items', [
            'resource_class_id' => [$lrmiClassId], 'site_id' => $siteId, 'limit' => 0,
        ])->getTotalResults();
    } catch (\Exception $e) {}
}

// Available item sets for the collections filter.
$availableItemSets = [];
try {
    $availableItemSets = $this->api()->search('item_sets', [
        'site_id' => $siteId, 'sort_by' => 'dcterms:title', 'sort_order' => 'asc', 'limit' => 100,
    ])->getContent();
} catch (\Exception $e) {}
$selectedItemSets = array_map('intval', $query['item_set_id'] ?? []);
$itemSetTitles    = [];
foreach ($availableItemSets as $_is) {
    $itemSetTitles[$_is->id()] = $_is->displayTitle();
}

// Curriculum lists (cur: model of curriculo_lomloe_canarias, loaded by the
// EducationalCurriculum module): current courses grouped by stage, and current stage
// subjects (cur:Materia). Filters then match the linked item by id (`res`), not by
// label: labels such as «Educación Primaria» match no course («1º Primaria»), and
// «Matemáticas» would also match «Matemáticas II». Without the curriculum the fixed
// lists below are kept (text `in` filters).
$anchorHelper = $this->getHelperPluginManager()->get('CurriculumAnchor');
$anchorClass  = get_class($anchorHelper);
$curStages    = [];
try {
    $_stages = $this->api()->search('items', ['resource_class_term' => 'cur:Etapa'])->getContent();
} catch (\Exception $e) {
    $_stages = [];
}
if ($_stages) {
    $_order = $anchorHelper->stageOrder();
    foreach ($_stages as $_st) {
        $_n = $_st->value('skos:notation');
        $_p = $_st->value('schema:position');
        $curStages[$_st->id()] = [
            'label'    => $_st->displayTitle(),
            'rank'     => $anchorClass::stageRank($_n ? (string) $_n : null, $_p ? (string) $_p : null, $_order),
            'courses'  => [],
            'subjects' => [],
        ];
    }
    // Current terms only: retired ones carry skos:changeNote.
    $_current = [
        ['property' => $anchorClass::CUR_STAGE, 'type' => 'ex'],
        ['joiner' => 'and', 'property' => 'skos:changeNote', 'type' => 'nex'],
    ];
    $_stageOf = function ($term) use ($anchorClass, $curStages) {
        foreach ($term->value($anchorClass::CUR_STAGE, ['all' => true]) ?: [] as $_v) {
            $_r = $_v->valueResource();
            if ($_r && isset($curStages[$_r->id()])) {
                return $_r->id();
            }
        }
        return null;
    };
    try {
        $_courses = $this->api()->search('items', ['resource_class_term' => 'cur:Curso', 'property' => $_current])->getContent();
    } catch (\Exception $e) {
        $_courses = [];
    }
    $_courseNotation = [];
    foreach ($_courses as $_c) {
        $_sid = $_stageOf($_c);
        if ($_sid !== null) {
            $curStages[$_sid]['courses'][$_c->id()] = $_c->displayTitle();
            $_courseNotation[$_c->id()] = (string) $_c->value('skos:notation');
        }
    }
    try {
        $_materias = $this->api()->search('items', [
            'resource_class_term' => 'cur:Materia',
            'property'            => $_current,
            'sort_by'             => 'title',
            'sort_order'          => 'asc',
        ])->getContent();
    } catch (\Exception $e) {
        $_materias = [];
    }
    foreach ($_materias as $_m) {
        $_sid = $_stageOf($_m);
        if ($_sid !== null) {
            $curStages[$_sid]['subjects'][$_m->id()] = $_m->displayTitle();
        }
    }
    foreach ($curStages as &$_st) {
        uksort($_st['courses'], function ($a, $b) use ($_courseNotation) {
            return strnatcmp($_courseNotation[$a] ?? '', $_courseNotation[$b] ?? '') ?: ($a <=> $b);
        });
    }
    unset($_st);
    uasort($curStages, fn($a, $b) => ($a['rank'] <=> $b['rank']) ?: strcmp($a['label'], $b['label']));
    unset($_stages, $_courses, $_materias, $_c, $_m, $_n, $_p, $_sid, $_order, $_current, $_courseNotation);
}
$curHasCourses  = (bool) array_filter(array_column($curStages, 'courses'));
$curHasSubjects = isset($eduProps['lrmi:educationalAlignment'])
    && (bool) array_filter(array_column($curStages, 'subjects'));
// Subject filter: stage subject by id when the curriculum is loaded, else schema:about by text.
$subjectTerm  = $curHasSubjects ? 'lrmi:educationalAlignment' : 'schema:about';
$subjectLabelById = [];
foreach ($curStages as $_st) {
    $subjectLabelById += $_st['subjects'];
}
unset($_st);

// Chip option lists.
$levelChips = [
    'Educación Infantil', 'Educación Primaria',
    '1º ESO', '2º ESO', '3º ESO', '4º ESO',
    '1º Bachillerato', '2º Bachillerato',
    'FP Básica', 'FP Grado Medio', 'FP Grado Superior',
];
$typeChips = [
    ['v' => 'Vídeo',                    'i' => 'play_circle'],
    ['v' => 'SCORM',                    'i' => 'interactive_space'],
    ['v' => 'PDF',                      'i' => 'picture_as_pdf'],
    ['v' => 'Texto',                    'i' => 'description'],
    ['v' => 'Infografía',               'i' => 'image'],
    ['v' => 'Situación de aprendizaje', 'i' => 'account_tree'],
    ['v' => 'Objeto de aprendizaje',    'i' => 'school'],
];
$audienceChips = ['Alumnado', 'Docente', 'Familias', 'NEAE', 'Centros educativos'];

// Pre-selected chip values per group (arrays for multi-select).
$lvlVals      = $propVals('lrmi:educationalLevel');
$typeVals     = $propVals('lrmi:learningResourceType');
$audienceVals = $propVals('lrmi:educationalRole');
$subjectVals  = $propVals($subjectTerm);    // multi-value pills

// Duration range: Omeka-S only supports eq/in/sw/ew/res/ex/dt for property queries.
// gte/lte are silently ignored. Workaround: build OR conditions for each matching
// integer value from the actual stored data. Values are passed to JS as JSON array.
// Display uses custom dur_min/dur_max params (unknown to Omeka, just for UI state).
$durPropId  = $eduProps['lrmi:timeRequired'] ?? 0;
$durationMin = (string) ($query['dur_min'] ?? '');
$durationMax = (string) ($query['dur_max'] ?? '');

// Query distinct integer values for this property via Omeka-S API.
// Used by JS to build exact OR-eq conditions (Omeka doesn't support gte/lte on literals).
$durValues = null; // null → JS falls back to multiples-of-5
if ($durPropId) {
    try {
        $durItems = $this->api()->search('items', [
            'property' => [['property' => (int) $durPropId, 'type' => 'ex']],
            'limit'    => 500,
        ])->getContent();
        $durValSet = [];
        foreach ($durItems as $dItem) {
            $dVal = $dItem->value('lrmi:timeRequired');
            if ($dVal) {
                $txt = trim($dVal->value());
                if (ctype_digit($txt) && (int) $txt > 0) {
                    $durValSet[(int) $txt] = true;
                }
            }
        }
        ksort($durValSet);
        $durValues = array_keys($durValSet);
    } catch (\Throwable $e) {
        $durValues = null;
    }
}

// Subject options for dropdown.
$subjectOptions = [
